{
  "name": "@creatoros/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "db:seed-demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "db:remove-demo": "node --env-file-if-exists=.env scripts/remove-demo.js",
    "db:add-test-brand": "node --env-file-if-exists=.env scripts/add-test-brand.js",
    "db:reset-test-brand": "node --env-file-if-exists=.env scripts/reset-test-brand.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "ai:smoke": "LOG_LEVEL=warn node --env-file-if-exists=.env scripts/ai-smoke.js",
    "discovery:smoke": "LOG_LEVEL=warn node --env-file-if-exists=.env scripts/discovery-smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "imapflow": "^2.5.7",
    "mailparser": "^3.9.47",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
