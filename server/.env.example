# ---------------------------------------------------------------------------
# CreatorOS server configuration. Copy to server/.env and fill in.
# Never commit .env. Secrets are never printed at startup.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Local MongoDB (see README "MongoDB setup").
MONGODB_URI=mongodb://127.0.0.1:27017/creatoros
# Comma-separated list of allowed browser origins (CORS + password reset links).
FRONTEND_URL=http://localhost:5173
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=168
# Set true only behind a trusted reverse proxy (for correct client IPs).
TRUST_PROXY=false
LOG_LEVEL=info

# --- AI (provider-independent layer; Anthropic Claude when configured) ------
# auto = anthropic if ANTHROPIC_API_KEY is set; otherwise mock in development
# and disabled in production (never a silent mock in production).
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
AI_TIMEOUT_MS=90000

# --- Email -------------------------------------------------------------------
# demo     = messages are recorded as "simulated" and never delivered
# smtp     = real delivery through your SMTP provider
# disabled = no sending at all
EMAIL_PROVIDER=demo
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CreatorOS
# Domain for per-conversation reply addresses: reply+<token>@<domain>.
# Your inbound email provider must forward these to POST /api/v1/webhooks/email.
EMAIL_REPLY_TO_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# HMAC secret shared with your inbound-email relay (see README "Inbound email").
INBOUND_WEBHOOK_SECRET=

# --- Discovery ---------------------------------------------------------------
# Comma-separated: demo (fictional dataset), rss (brand newsroom feeds), brave (Brave Search API)
DISCOVERY_SOURCES=demo,rss
DISCOVERY_INTERVAL_MINUTES=1440
DISCOVERY_MIN_INTERVAL_MINUTES=60
DISCOVERY_MAX_CONCURRENCY=2
DISCOVERY_MANUAL_RUNS_PER_DAY=6
BRAVE_SEARCH_API_KEY=

# --- Background worker -------------------------------------------------------
# true = the API process also runs the worker (simplest for development).
# In production run `npm run worker` separately and set this to false.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_MS=5000
WORKER_LEASE_MS=300000

# --- Demo features (simulated brand replies, demo discovery source) -----------
DEMO_FEATURES_ENABLED=true
# Production refuses demo integrations unless this is explicitly true (staging demos only).
ALLOW_DEMO_IN_PRODUCTION=false
