# ---------------------------------------------------------------------------
# CreatorOS server configuration. Copy to server/.env and fill in.
# Never commit .env. Secrets are never printed at startup.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Local MongoDB (see README "MongoDB setup").
MONGODB_URI=mongodb://127.0.0.1:27017/creatoros
# Comma-separated list of allowed browser origins (CORS + password reset links).
FRONTEND_URL=http://localhost:5173
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Encrypts stored integration tokens (Instagram). Different from AUTH_SECRET, so
# rotating AUTH_SECRET doesn't disconnect creators. Required in production;
# in development AUTH_SECRET is used when this is empty. Generate it the same way.
ENCRYPTION_KEY=
SESSION_TTL_HOURS=168
# Set true only behind a trusted reverse proxy (for correct client IPs).
TRUST_PROXY=false
LOG_LEVEL=info

# --- AI (provider-independent layer; Anthropic Claude when configured) ------
# auto = anthropic if ANTHROPIC_API_KEY is set, else gemini if GEMINI_API_KEY is set; otherwise mock in development
# and disabled in production (never a silent mock in production).
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Google Gemini (free tier works for development). Used by AI_PROVIDER=auto
# when ANTHROPIC_API_KEY is empty. Free-tier prompts may be used by Google to
# improve its products: use test data only, never real creators' emails.
GEMINI_API_KEY=
# gemini-3.5-flash-lite: fast, separate free quota. gemini-3.8-flash is stronger but
# its free tier allows only 20 requests per day.
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high (classification always uses low)
GEMINI_THINKING_LEVEL=medium
AI_TIMEOUT_MS=90000

# --- Email -------------------------------------------------------------------
# demo     = messages are recorded as "simulated" and never delivered
# smtp     = real delivery through your SMTP provider
# disabled = no sending at all
EMAIL_PROVIDER=demo
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CreatorOS
# Domain for per-conversation reply addresses: reply+<token>@<domain>.
# Your inbound email provider must forward these to POST /api/v1/webhooks/email.
EMAIL_REPLY_TO_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# HMAC secret shared with your inbound-email relay (see README "Inbound email").
INBOUND_WEBHOOK_SECRET=

# --- Development: send and receive with your own Gmail (no domain needed) -------
# 1) Turn on 2-Step Verification, 2) create an app password at
# https://myaccount.google.com/apppasswords, 3) uncomment these lines, replace
# you@gmail.com everywhere and paste the 16-character app password (no spaces).
# The reply address must contain {token}; Gmail delivers you+cos-...@gmail.com to you.
# These lines come after the email settings above, so they override them.
# EMAIL_PROVIDER=smtp
# EMAIL_FROM_ADDRESS=you@gmail.com
# EMAIL_REPLY_TO_ADDRESS=you+cos-{token}@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# INBOUND_PROVIDER=imap
# IMAP_HOST=imap.gmail.com
# (IMAP_USER / IMAP_PASS default to the SMTP ones; IMAP_PORT=993, IMAP_MAILBOX=INBOX)

# --- Discovery ---------------------------------------------------------------
# Comma-separated: demo (fictional dataset), rss (brand newsroom feeds), brave (Brave Search API),
# gdelt (Indian business news, free), serper (needs SERPER_API_KEY), instagram (needs APIFY_TOKEN)
DISCOVERY_SOURCES=demo,rss
DISCOVERY_INTERVAL_MINUTES=1440
DISCOVERY_MIN_INTERVAL_MINUTES=60
DISCOVERY_MAX_CONCURRENCY=2
DISCOVERY_MANUAL_RUNS_PER_DAY=6
BRAVE_SEARCH_API_KEY=
# Real discovery sources (add gdelt,serper,instagram to DISCOVERY_SOURCES).
# Serper: https://serper.dev (2,500 free searches on sign-up)
SERPER_API_KEY=
# Apify (Instagram): https://console.apify.com/settings/integrations ($5 free credit/month)
APIFY_TOKEN=
APIFY_MAX_USD_PER_RUN=0.5

# Instagram DMs (official Instagram API with Instagram Login).
# For development you don't need these: connect in Settings -> Integrations by
# pasting the token the Meta app dashboard generates for your tester account.
# Login ("Connect with Instagram") needs all three; the redirect must be HTTPS
# and registered in the Meta app, e.g. https://your-domain/api/v1/integrations/instagram/callback
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=
# INSTAGRAM_API_VERSION=v26.0
# INSTAGRAM_POLL_DMS=true

# --- Background worker -------------------------------------------------------
# true = the API process also runs the worker (simplest for development).
# In production run `npm run worker` separately and set this to false.
RUN_WORKER_IN_PROCESS=true
WORKER_POLL_MS=5000
WORKER_LEASE_MS=300000

# --- Demo features (simulated brand replies, demo discovery source) -----------
DEMO_FEATURES_ENABLED=true
# Production refuses demo integrations unless this is explicitly true (staging demos only).
ALLOW_DEMO_IN_PRODUCTION=false
